config_version=5
[application]
config/name="After Hours - Border Inn"
config/version="1.7.5-underworld"
config/use_custom_user_dir=true
config/custom_user_dir_name="AfterHoursBorderInn"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=720
window/size/viewport_height=1360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/window_width_override=540
window/size/window_height_override=1020
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07,0.10,0.14,1)

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_mouse_from_touch=true
