config_version=5
[application]
config/name="문 닫은 뒤 · 2D 단면 실험"
config/version="1.0-episode"
config/use_custom_user_dir=true
config/custom_user_dir_name="AfterHoursSideview"
run/main_scene="res://sandbox.tscn"
[display]
window/size/viewport_width=720
window/size/viewport_height=1360
window/size/window_width_override=540
window/size/window_height_override=1020
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.045,0.06,0.085,1)
[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true
