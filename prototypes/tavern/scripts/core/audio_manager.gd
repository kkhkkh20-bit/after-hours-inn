extends Node
## Pooled audio playback. All clips are generated by tools/gen_audio.py.
##
## SFX use a small voice pool so overlapping sounds never cut each other off,
## which matters because cooking fires several cues in quick succession.

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
const AMBIENCE_DIR := "res://assets/audio/ambience/"
const VOICES := 10

var sfx_volume: float = 0.8
var music_volume: float = 0.5
var ambience_volume: float = 0.45

var _voices: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _music: AudioStreamPlayer
var _ambience: AudioStreamPlayer
var _current_music: String = ""
var _current_ambience: String = ""
var _cache: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "Master"
		add_child(p)
		_voices.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Master"
	add_child(_music)
	_music.finished.connect(_loop_music)
	_ambience = AudioStreamPlayer.new()
	_ambience.bus = "Master"
	add_child(_ambience)
	_ambience.finished.connect(_loop_ambience)


func _stream(path: String) -> AudioStream:
	if _cache.has(path):
		return _cache[path]
	if not ResourceLoader.exists(path):
		return null
	var s: AudioStream = load(path)
	_cache[path] = s
	return s


func play_sfx(name: String, pitch: float = 1.0, volume_scale: float = 1.0) -> void:
	var s := _stream(SFX_DIR + name + ".wav")
	if s == null:
		return
	var p := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % VOICES
	p.stream = s
	p.pitch_scale = pitch
	p.volume_db = linear_to_db(maxf(0.001, sfx_volume * volume_scale))
	p.play()


## Slight random pitch keeps repeated cues (footsteps, chopping) from becoming
## a machine-gun. Cheap, and it is most of what "game feel" means in audio.
func play_sfx_varied(name: String, spread: float = 0.10) -> void:
	play_sfx(name, 1.0 + randf_range(-spread, spread))


func play_music(name: String) -> void:
	if name == _current_music:
		return
	var s := _stream(MUSIC_DIR + name + ".wav")
	if s == null:
		return
	_current_music = name
	_music.stream = s
	_music.volume_db = linear_to_db(maxf(0.001, music_volume))
	_music.play()


func stop_music() -> void:
	_current_music = ""
	_music.stop()


func play_ambience(name: String) -> void:
	if name == _current_ambience:
		return
	var s := _stream(AMBIENCE_DIR + name + ".wav")
	if s == null:
		return
	_current_ambience = name
	_ambience.stream = s
	_ambience.volume_db = linear_to_db(maxf(0.001, ambience_volume))
	_ambience.play()


func stop_ambience() -> void:
	_current_ambience = ""
	_ambience.stop()


# Generated WAVs carry no loop metadata, so looping is done by restarting on
# finish. Simpler than rewriting the files with loop points.
func _loop_music() -> void:
	if _current_music != "":
		_music.play()


func _loop_ambience() -> void:
	if _current_ambience != "":
		_ambience.play()


func set_volumes(sfx: float, music: float, ambience: float) -> void:
	sfx_volume = clampf(sfx, 0.0, 1.0)
	music_volume = clampf(music, 0.0, 1.0)
	ambience_volume = clampf(ambience, 0.0, 1.0)
	_music.volume_db = linear_to_db(maxf(0.001, music_volume))
	_ambience.volume_db = linear_to_db(maxf(0.001, ambience_volume))
